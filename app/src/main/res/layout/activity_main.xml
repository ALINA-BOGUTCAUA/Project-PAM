<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fde8d3">

    <!-- Верхний блок -->

    <!-- Основная часть с карточками и статистикой -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="#ffdfba"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Мы всегда заботимся о вашем здоровье. Пожалуйста, заботьтесь и вы о нём."
            android:textColor="#333333"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- Шаги -->
            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_steps"
                android:gravity="center_vertical"
                android:elevation="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👟"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/stepsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Шаги: 0"
                    android:textSize="22sp"
                    android:textColor="#ff5722"/>
            </LinearLayout>

            <!-- Калории -->
            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_calories"
                android:gravity="center_vertical"
                android:elevation="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/caloriesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Калории: 0"
                    android:textSize="22sp"
                    android:textColor="#ff9800"/>
            </LinearLayout>

            <!-- Расстояние -->
            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_distance"
                android:gravity="center_vertical"
                android:elevation="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📏"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/distanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Расстояние: 0 км"
                    android:textSize="22sp"
                    android:textColor="#ffffff"/>
            </LinearLayout>

            <!-- Пустой блок для статистики -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="20dp"
                android:background="#e8f0f2"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:text="Здесь будет статистика"
                    android:textSize="18sp"
                    android:textColor="#555555"/>
            </LinearLayout>

            <!-- Итог за неделю -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                android:background="#dce7d8"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:text="Итог за неделю по установленной цели"
                    android:textSize="18sp"
                    android:textColor="#333333"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Нижняя навигационная панель (полупрозрачная) -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#99ffffff"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Главная"
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:background="#657166"/>

        <TextView
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Карта"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Аккаунт"
            android:textSize="16sp"
            android:textColor="#333333"/>
    </LinearLayout>

</LinearLayout>
