<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fde8d3">

    <!-- Верхний блок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#ffdfba"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мы всегда заботимся о вашем здоровье. Пожалуйста, заботьтесь и вы о нём. Любите себя так, как любим мы вас."
            android:textSize="16sp"
            android:textColor="#333333"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>

    <!-- Карточки с шагами, калориями и расстоянием -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="20dp">

        <!-- Шаги -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/card_steps"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👟"
                android:textSize="24sp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/stepsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Шаги: 0"
                android:textSize="22sp"
                android:textColor="#ff5722"/>
        </LinearLayout>

        <!-- Калории -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/card_calories"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="24sp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/caloriesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Калории: 0"
                android:textSize="22sp"
                android:textColor="#ff9800"/>
        </LinearLayout>

        <!-- Расстояние -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/card_distance"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏"
                android:textSize="24sp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/distanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Расстояние: 0 км"
                android:textSize="22sp"
                android:textColor="#ffffff"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Нижняя навигационная панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#daebe3"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Главная"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/navRecommendations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Рекомендации"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Аккаунт"
            android:textSize="16sp"
            android:textColor="#333333"/>
    </LinearLayout>

</LinearLayout>