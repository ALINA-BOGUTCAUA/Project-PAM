<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CAEFE2">

    <!-- Верхний приветственный блок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D4F2E5"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Здравствуйте, юзер!"
            android:textColor="#000000"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Основная часть -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp">

            <!-- Карточки шагов, калорий и расстояния -->
            <LinearLayout
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/card_steps"
                android:gravity="center_vertical"
                android:elevation="6dp"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👟"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/stepsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Шаги: 0"
                    android:textSize="22sp"
                    android:textColor="#3AB896"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/card_calories"
                android:gravity="center_vertical"
                android:elevation="6dp"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/caloriesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Калории: 0"
                    android:textSize="22sp"
                    android:textColor="#FF9800"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/card_distance"
                android:gravity="center_vertical"
                android:elevation="6dp"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📏"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/distanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Расстояние: 0 км"
                    android:textSize="22sp"
                    android:textColor="#000000"/>
            </LinearLayout>

            <!-- Блок статистики с круговыми прогресс-барами -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/card_statistics"
                android:elevation="4dp"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Статистика"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="2">

                    <!-- Прогресс шагов -->
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="16dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressSteps"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:indicatorSize="90dp"
                            app:trackThickness="10dp"
                            app:indicatorColor="#3AB896"
                            app:trackColor="#C8E6C9"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStepsProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#3AB896"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="шаги"
                                android:textSize="12sp"
                                android:textColor="#555555"/>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Прогресс калорий -->
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressCalories"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:indicatorSize="90dp"
                            app:trackThickness="10dp"
                            app:indicatorColor="#FF9800"
                            app:trackColor="#FFE0B2"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCaloriesProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FF9800"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ккал"
                                android:textSize="12sp"
                                android:textColor="#555555"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Итог за неделю -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_week_summary"
                android:orientation="vertical"
                android:gravity="center"
                android:elevation="4dp"
                android:padding="16dp"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Итог за неделю"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal"
                    android:gravity="bottom|center"
                    android:weightSum="3">

                    <!-- Мини-графики -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <View
                            android:layout_width="20dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bar_steps"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👟"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <View
                            android:layout_width="20dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bar_calories"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <View
                            android:layout_width="20dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bar_distance"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📏"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Нижняя навигация -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/nav_bar_background"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Главная"
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:background="@drawable/nav_active_background"/>

        <TextView
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Карта"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Аккаунт"
            android:textSize="16sp"
            android:textColor="#333333"/>
    </LinearLayout>

</LinearLayout>
