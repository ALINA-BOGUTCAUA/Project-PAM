<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7F4">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Создание аккаунта"
            android:textSize="22sp"
            android:textColor="#2C7A73"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textStyle="bold"/>

        <!-- Поля с скруглением и тенью -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Имя"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounded_edit_text"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounded_edit_text"/>

        <EditText
            android:id="@+id/etGender"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Пол"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounded_edit_text"/>

        <EditText
            android:id="@+id/etHeight"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Рост (см)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounded_edit_text"/>

        <EditText
            android:id="@+id/etWeight"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Вес (кг)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounded_edit_text"/>

        <EditText
            android:id="@+id/etCalorieLimit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Лимит калорий"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounded_edit_text"/>

        <EditText
            android:id="@+id/etStepLimit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Лимит шагов"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_edit_text"/>

        <!-- Кнопка регистрации -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Зарегистрироваться"
            android:background="@drawable/rounded_button"
            android:textColor="#ffffff"
            android:textSize="18sp"/>
    </LinearLayout>
</ScrollView>
