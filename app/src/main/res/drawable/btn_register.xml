<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Скругленные углы -->
    <corners android:radius="12dp" />

    <!-- Градиент -->
    <gradient
        android:startColor="#3AB896"
        android:endColor="#2C7A73"
        android:angle="90"/>

    <!-- Тень (через stroke для контраста) -->
    <stroke
        android:width="1dp"
        android:color="#2C7A73"/>
</shape>
